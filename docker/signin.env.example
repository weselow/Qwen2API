# Copy to a private env file OUTSIDE Git and fill in. See docs/signin-worker.md.
# App secret: existing production key or a fresh random one for a test stand.
API_KEY=change-me
# Shared bearer secret app -> signin-worker; generate e.g. `openssl rand -hex 32`.
# Empty disables auth (internal-network deployments only).
SIGNIN_WORKER_TOKEN=
# Optional overrides:
# V2_SESSION_MODE=off restores the v1 path without touching anything else.
#V2_SESSION_MODE=browser
#SIGNIN_HEADLESS=true
#QWEN_DATA_DIR=/absolute/data
#QWEN_LOGS_DIR=/absolute/logs
#QWEN_CACHES_DIR=/absolute/caches
#QWEN_PORT_BINDING=127.0.0.1:23215:3000
#SIGNIN_PROFILES_DIR=/absolute/signin-profiles
