# Copy to a private file outside Git, or enter these variables in Coolify.
# Full production stack: Qwen2API + signin-worker + dnsproxy
# (docker/docker-compose.prod.yml). Superset of dns.env.example and
# signin.env.example. See docs/prod-hybrid-deploy.md.
# Replace with the EXISTING key when migrating an existing deployment.
API_KEY=
# Plain DNS and independent bootstrap, both IP:port (never sidecar/Docker DNS).
DNS_UPSTREAM=10.20.0.151:53
DNS_BOOTSTRAP=10.20.0.151:53
# Example only: check Docker, LAN and VPN routes before selecting a subnet.
# A SECOND stack on the same host (test/preview) must take a different
# subnet AND sidecar IP: dnsproxy pins its static IP per network.
DNS_SUBNET=172.30.53.0/24
DNS_SIDECAR_IP=172.30.53.53
# Shared bearer secret app -> signin-worker; generate e.g. `openssl rand -hex 32`.
# Empty disables auth (internal-network deployments only).
SIGNIN_WORKER_TOKEN=
# v2 pipeline switches. Rollback to the v1 path (config-only):
#   V2_SESSION_MODE=off
#   COMPLETIONS_TRANSPORT=axios
# then redeploy. Defaults: browser / auto.
#V2_SESSION_MODE=browser
#COMPLETIONS_TRANSPORT=auto
# chats/new from inside the signin worker's resident page (Qwen2API-3ue.2,
# docs/browser-egress-design.md). Compose ships it OFF (direct): switch it on
# explicitly with browser (forced) once the worker image with /egress is
# deployed, one chats/new probe first; back to direct rolls it off.
#CHAT_CREATION_TRANSPORT=direct
# completions from inside the same resident page, streamed (Qwen2API-3ue.3).
# Ships OFF (auto: curl-impersonate, else axios; "auto" never picks browser).
# Switch it on explicitly once chats/new through the worker is proven, one
# "pong" first; back to auto rolls it off.
#COMPLETIONS_TRANSPORT=auto
# Session recovery throttles, per account (ms): how often a refused session
# may reload its page, and how often a dead profile may be re-logged in.
#V2_SESSION_RECOVERY_MIN_INTERVAL_MS=30000
#V2_SESSION_RELOGIN_MIN_INTERVAL_MS=60000
# Optional overrides:
#SIGNIN_HEADLESS=true
# Which headless browser the worker runs (docs/browser-egress-design.md,
# "HeadlessChrome"): shell (default, as before) or chrome — the full Chromium,
# presenting as a browser with a window; about twice the memory. Only while
# SIGNIN_HEADLESS is true. Anything else refuses to start the worker.
#SIGNIN_HEADLESS_MODE=shell
#SIGNIN_PROFILES_DIR=/absolute/signin-profiles
# Resident pages of the signin worker (browser egress, docs/browser-egress-design.md):
# one Chromium (~200-300 MB) per account that generates. Defaults shown.
#MAX_RESIDENT_PAGES=16
#RESIDENT_KEEPALIVE_MS=300000
#SIGNIN_EGRESS_MAX_TIMEOUT_MS=600000
# Cap on a streamed completions answer, in bytes; 0 = none (the answer is
# relayed as it comes, not buffered).
#SIGNIN_EGRESS_MAX_STREAM_BYTES=0
# Full logins of the signin worker go one at a time, this far apart (+ up to
# the same again as jitter): batched sign-ins from one IP get it blocked by
# qwen.ai. A /session waiting longer than MAX_WAIT is refused (429), to retry.
#SIGNIN_LOGIN_MIN_INTERVAL_MS=30000
#SIGNIN_LOGIN_MAX_WAIT_MS=120000
# Since 2026-11-26 (Qwen2API-xun, Qwen2API-nch, Qwen2API-ops), for many accounts. Defaults shown.
# A page's token is renewed in place before a call that finds it nearly spent, instead of
# the page being reloaded for the refused call. false = off: a refusal is the app's recovery's
# alone (a reload, a retry). The refreshes of every page start at least MIN_INTERVAL apart; 1 = off.
#SIGNIN_PAGE_TOKEN_REFRESH=true
#SIGNIN_TOKEN_REFRESH_MIN_INTERVAL_MS=2000
# A navigation on a live page (a renewal, a sign-in) waits this long for the streams running
# on it, which a reload cuts; 0 = it does not wait.
#RESIDENT_STREAM_WAIT_MS=20000
# Every page load of every account (a lazy open, a renewal, a sign-in) starts at least this far
# from the previous one, plus up to the same again as jitter; 1 = no queue.
#RESIDENT_LOAD_MIN_INTERVAL_MS=10000
# App -> worker call budget. Must stay above SIGNIN_LOGIN_MAX_WAIT_MS + 120000.
#SIGNIN_WORKER_TIMEOUT_MS=240000
#QWEN_DATA_DIR=/absolute/data
#QWEN_LOGS_DIR=/absolute/logs
#QWEN_CACHES_DIR=/absolute/caches
#QWEN_PORT_BINDING=3000:3000
#DATA_SAVE_MODE=file
#CACHE_MODE=file
#LISTEN_ADDRESS=
#SEARCH_INFO_MODE=table
#OUTPUT_THINK=true
#SIMPLE_MODEL_MAP=false
#REDIS_URL=
#ACCOUNTS=
