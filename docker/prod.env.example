# Copy to a private file outside Git, or enter these variables in Coolify.
# Full production stack: Qwen2API + signin-worker + dnsproxy
# (docker/docker-compose.prod.yml). Superset of dns.env.example and
# signin.env.example. See docs/prod-hybrid-deploy.md.
# Replace with the EXISTING key when migrating an existing deployment.
API_KEY=
# Plain DNS and independent bootstrap, both IP:port (never sidecar/Docker DNS).
DNS_UPSTREAM=10.20.0.151:53
DNS_BOOTSTRAP=10.20.0.151:53
# Example only: check Docker, LAN and VPN routes before selecting a subnet.
# A SECOND stack on the same host (test/preview) must take a different
# subnet AND sidecar IP: dnsproxy pins its static IP per network.
DNS_SUBNET=172.30.53.0/24
DNS_SIDECAR_IP=172.30.53.53
# Shared bearer secret app -> signin-worker; generate e.g. `openssl rand -hex 32`.
# Empty disables auth (internal-network deployments only).
SIGNIN_WORKER_TOKEN=
# v2 pipeline switches. Rollback to the v1 path (config-only):
#   V2_SESSION_MODE=off
#   COMPLETIONS_TRANSPORT=axios
# then redeploy. Defaults: browser / auto.
#V2_SESSION_MODE=browser
#COMPLETIONS_TRANSPORT=auto
# Optional overrides:
#SIGNIN_HEADLESS=true
#SIGNIN_PROFILES_DIR=/absolute/signin-profiles
#QWEN_DATA_DIR=/absolute/data
#QWEN_LOGS_DIR=/absolute/logs
#QWEN_CACHES_DIR=/absolute/caches
#QWEN_PORT_BINDING=3000:3000
#DATA_SAVE_MODE=file
#CACHE_MODE=file
#LISTEN_ADDRESS=
#SEARCH_INFO_MODE=table
#OUTPUT_THINK=true
#SIMPLE_MODEL_MAP=false
#REDIS_URL=
#ACCOUNTS=
